# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/docchain

# --- JWT ---
# Generate a real value before deploying anywhere real, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with a missing/placeholder/short secret.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Rate limiting ---
# Applies to /auth/register, /auth/login, /auth/forgot-password,
# /auth/reset-password (AUTH_RATE_LIMIT_MAX) and to upload/sign/reject/
# change-password, the PIN- or password-guarded actions (PIN_RATE_LIMIT_MAX).
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PIN_RATE_LIMIT_MAX=30

# --- Fabric network ---
# Keep FABRIC_MOCK=true until a real Fabric network + chaincode are deployed
# and the connection profile / wallet paths below are real. With
# FABRIC_MOCK=true, the full API contract works with no live Fabric network
# required — flip to false once fabric.service.js is wired to a real gateway.
FABRIC_MOCK=true
FABRIC_CHANNEL_NAME=documentchannel
FABRIC_CHAINCODE_NAME=doccc
FABRIC_CONNECTION_PROFILE=./src/config/connection-profile.json
FABRIC_WALLET_PATH=./wallet
FABRIC_CA_URL=https://localhost:7054
FABRIC_CA_NAME=ca-org1
FABRIC_MSP_ID=Org1MSP
FABRIC_ADMIN_USER=admin
FABRIC_ADMIN_PASSWORD=adminpw

# --- Uploads ---
MAX_UPLOAD_MB=10

# --- Regulator seed script (npm run seed) ---
# Only used by src/utils/seed.js — not read by the running server.
SEED_REGULATOR_EMAIL=regulator@docchain.local
SEED_REGULATOR_PASSWORD=Regulator@123
SEED_REGULATOR_NAME=Regulator
SEED_REGULATOR_EMPLOYEE_ID=
